# Copy this file to .env and fill in real values. Never commit the real .env file.

FLASK_ENV=development
PORT=5000

# TLS (platform_service.py, production only - run.py/dev is plain HTTP).
# Defaults to certs/cert.pem + certs/key.pem beside platform_service.py if
# unset - run scripts/generate_dev_cert.ps1 for a self-signed one to start
# with, or point these at a real, CA-issued certificate for production.
# Refuses to start over plaintext unless ALLOW_PLAINTEXT=1 is set - remote-
# support sessions (screen + input) must not cross the network unencrypted.
# TLS_CERT_FILE=certs/cert.pem
# TLS_KEY_FILE=certs/key.pem
# ALLOW_PLAINTEXT=1

SECRET_KEY=change-me-to-a-random-value
JWT_SECRET_KEY=change-me-to-a-different-random-value
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=28800

SQL_SERVER=localhost
SQL_DATABASE=ApplicationMonitoringDB
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Optional full override, e.g. for testing with SQLite:
# DATABASE_URL=sqlite:///dev.db

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=monitoring@example.com

MONITOR_INTERVAL=30
DEFAULT_TIMEOUT=10
DEFAULT_RETRY_COUNT=3
DEFAULT_RETRY_DELAY=5

CORS_ORIGINS=*
