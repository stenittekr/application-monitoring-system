# Copy this file to .env and fill in real values. Never commit the real .env file.

FLASK_ENV=development
PORT=5000

SECRET_KEY=change-me-to-a-random-value
JWT_SECRET_KEY=change-me-to-a-different-random-value
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=28800

SQL_SERVER=localhost
SQL_DATABASE=ApplicationMonitoringDB
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Optional full override, e.g. for testing with SQLite:
# DATABASE_URL=sqlite:///dev.db

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=monitoring@example.com

MONITOR_INTERVAL=30
DEFAULT_TIMEOUT=10
DEFAULT_RETRY_COUNT=3
DEFAULT_RETRY_DELAY=5

CORS_ORIGINS=*
